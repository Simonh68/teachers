{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Classroom materials manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "grade",
    "materials"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "grade": {
      "type": "integer",
      "minimum": 7,
      "maximum": 12
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "unit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "worksheet": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}