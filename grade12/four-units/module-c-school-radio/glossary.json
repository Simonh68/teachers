{
  "units": [
    {
      "id": "gloss-1",
      "paragraph": 1,
      "en": "Every Friday,",
      "he": "בכל יום שישי",
      "start_word": 0,
      "end_word": 1
    },
    {
      "id": "gloss-2",
      "paragraph": 1,
      "en": "pupils at Green Hill School",
      "he": "תלמידים בבית הספר גרין היל",
      "start_word": 2,
      "end_word": 6
    },
    {
      "id": "gloss-3",
      "paragraph": 1,
      "en": "hear familiar voices",
      "he": "שומעים קולות מוכרים",
      "start_word": 7,
      "end_word": 9
    },
    {
      "id": "gloss-4",
      "paragraph": 1,
      "en": "during the morning break.",
      "he": "במהלך הפסקת הבוקר",
      "start_word": 10,
      "end_word": 13
    },
    {
      "id": "gloss-5",
      "paragraph": 1,
      "en": "The voices come from",
      "he": "הקולות מגיעים מ־",
      "start_word": 14,
      "end_word": 17
    },
    {
      "id": "gloss-6",
      "paragraph": 1,
      "en": "a small room",
      "he": "חדר קטן",
      "start_word": 18,
      "end_word": 20
    },
    {
      "id": "gloss-7",
      "paragraph": 1,
      "en": "next to the library,",
      "he": "ליד הספרייה",
      "start_word": 21,
      "end_word": 24
    },
    {
      "id": "gloss-8",
      "paragraph": 1,
      "en": "where a group of pupils",
      "he": "שבו קבוצת תלמידים",
      "start_word": 25,
      "end_word": 29
    },
    {
      "id": "gloss-9",
      "paragraph": 1,
      "en": "makes a radio programme.",
      "he": "מכינה תוכנית רדיו",
      "start_word": 30,
      "end_word": 33
    },
    {
      "id": "gloss-10",
      "paragraph": 1,
      "en": "The programme includes",
      "he": "התוכנית כוללת",
      "start_word": 34,
      "end_word": 36
    },
    {
      "id": "gloss-11",
      "paragraph": 1,
      "en": "school news,",
      "he": "חדשות בית הספר",
      "start_word": 37,
      "end_word": 38
    },
    {
      "id": "gloss-12",
      "paragraph": 1,
      "en": "short interviews",
      "he": "ראיונות קצרים",
      "start_word": 39,
      "end_word": 40
    },
    {
      "id": "gloss-13",
      "paragraph": 1,
      "en": "and music.",
      "he": "ומוזיקה",
      "start_word": 41,
      "end_word": 42
    },
    {
      "id": "gloss-14",
      "paragraph": 1,
      "en": "It began when",
      "he": "היא התחילה כאשר",
      "start_word": 43,
      "end_word": 45
    },
    {
      "id": "gloss-15",
      "paragraph": 1,
      "en": "an English teacher noticed",
      "he": "מורה לאנגלית הבחינה",
      "start_word": 46,
      "end_word": 49
    },
    {
      "id": "gloss-16",
      "paragraph": 1,
      "en": "that some quiet pupils",
      "he": "שכמה תלמידים שקטים",
      "start_word": 50,
      "end_word": 53
    },
    {
      "id": "gloss-17",
      "paragraph": 1,
      "en": "had interesting ideas",
      "he": "היו בעלי רעיונות מעניינים",
      "start_word": 54,
      "end_word": 56
    },
    {
      "id": "gloss-18",
      "paragraph": 1,
      "en": "but rarely shared them",
      "he": "אך כמעט שלא שיתפו אותם",
      "start_word": 57,
      "end_word": 60
    },
    {
      "id": "gloss-19",
      "paragraph": 1,
      "en": "in class.",
      "he": "בכיתה",
      "start_word": 61,
      "end_word": 62
    },
    {
      "id": "gloss-20",
      "paragraph": 1,
      "en": "She wanted to give them",
      "he": "היא רצתה לתת להם",
      "start_word": 63,
      "end_word": 67
    },
    {
      "id": "gloss-21",
      "paragraph": 1,
      "en": "another way",
      "he": "דרך נוספת",
      "start_word": 68,
      "end_word": 69
    },
    {
      "id": "gloss-22",
      "paragraph": 1,
      "en": "to be heard.",
      "he": "להשמיע את קולם",
      "start_word": 70,
      "end_word": 72
    },
    {
      "id": "gloss-23",
      "paragraph": 2,
      "en": "At first,",
      "he": "בתחילה",
      "start_word": 73,
      "end_word": 74
    },
    {
      "id": "gloss-24",
      "paragraph": 2,
      "en": "only six pupils",
      "he": "רק שישה תלמידים",
      "start_word": 75,
      "end_word": 77
    },
    {
      "id": "gloss-25",
      "paragraph": 2,
      "en": "joined the radio team.",
      "he": "הצטרפו לצוות הרדיו",
      "start_word": 78,
      "end_word": 81
    },
    {
      "id": "gloss-26",
      "paragraph": 2,
      "en": "They used",
      "he": "הם השתמשו ב־",
      "start_word": 82,
      "end_word": 83
    },
    {
      "id": "gloss-27",
      "paragraph": 2,
      "en": "an old computer",
      "he": "מחשב ישן",
      "start_word": 84,
      "end_word": 86
    },
    {
      "id": "gloss-28",
      "paragraph": 2,
      "en": "and a microphone",
      "he": "ובמיקרופון",
      "start_word": 87,
      "end_word": 89
    },
    {
      "id": "gloss-29",
      "paragraph": 2,
      "en": "that the school already owned.",
      "he": "שכבר היו ברשות בית הספר",
      "start_word": 90,
      "end_word": 94
    },
    {
      "id": "gloss-30",
      "paragraph": 2,
      "en": "Before their first programme,",
      "he": "לפני התוכנית הראשונה שלהם",
      "start_word": 95,
      "end_word": 98
    },
    {
      "id": "gloss-31",
      "paragraph": 2,
      "en": "they asked classmates",
      "he": "הם שאלו חברים לכיתה",
      "start_word": 99,
      "end_word": 101
    },
    {
      "id": "gloss-32",
      "paragraph": 2,
      "en": "what they wanted to hear.",
      "he": "מה הם רוצים לשמוע",
      "start_word": 102,
      "end_word": 106
    },
    {
      "id": "gloss-33",
      "paragraph": 2,
      "en": "Most asked for music,",
      "he": "רובם ביקשו מוזיקה",
      "start_word": 107,
      "end_word": 110
    },
    {
      "id": "gloss-34",
      "paragraph": 2,
      "en": "but some wanted advice",
      "he": "אך כמה מהם רצו עצות",
      "start_word": 111,
      "end_word": 114
    },
    {
      "id": "gloss-35",
      "paragraph": 2,
      "en": "about school life.",
      "he": "על החיים בבית הספר",
      "start_word": 115,
      "end_word": 117
    },
    {
      "id": "gloss-36",
      "paragraph": 2,
      "en": "The team decided",
      "he": "הצוות החליט",
      "start_word": 118,
      "end_word": 120
    },
    {
      "id": "gloss-37",
      "paragraph": 2,
      "en": "to include both.",
      "he": "לכלול את שני הדברים",
      "start_word": 121,
      "end_word": 123
    },
    {
      "id": "gloss-38",
      "paragraph": 2,
      "en": "Pupils who did not want to speak",
      "he": "תלמידים שלא רצו לדבר",
      "start_word": 124,
      "end_word": 130
    },
    {
      "id": "gloss-39",
      "paragraph": 2,
      "en": "could choose music",
      "he": "יכלו לבחור מוזיקה",
      "start_word": 131,
      "end_word": 133
    },
    {
      "id": "gloss-40",
      "paragraph": 2,
      "en": "or write questions for interviews.",
      "he": "או לכתוב שאלות לראיונות",
      "start_word": 134,
      "end_word": 138
    },
    {
      "id": "gloss-41",
      "paragraph": 2,
      "en": "Everyone had",
      "he": "לכל אחד היה",
      "start_word": 139,
      "end_word": 140
    },
    {
      "id": "gloss-42",
      "paragraph": 2,
      "en": "a useful job.",
      "he": "תפקיד מועיל",
      "start_word": 141,
      "end_word": 143
    },
    {
      "id": "gloss-43",
      "paragraph": 3,
      "en": "Making a programme",
      "he": "הכנת תוכנית",
      "start_word": 144,
      "end_word": 146
    },
    {
      "id": "gloss-44",
      "paragraph": 3,
      "en": "was harder than",
      "he": "הייתה קשה יותר ממה ש־",
      "start_word": 147,
      "end_word": 149
    },
    {
      "id": "gloss-45",
      "paragraph": 3,
      "en": "the team expected.",
      "he": "הצוות ציפה",
      "start_word": 150,
      "end_word": 152
    },
    {
      "id": "gloss-46",
      "paragraph": 3,
      "en": "During their first interview,",
      "he": "במהלך הריאיון הראשון שלהם",
      "start_word": 153,
      "end_word": 156
    },
    {
      "id": "gloss-47",
      "paragraph": 3,
      "en": "two pupils spoke",
      "he": "שני תלמידים דיברו",
      "start_word": 157,
      "end_word": 159
    },
    {
      "id": "gloss-48",
      "paragraph": 3,
      "en": "at the same time,",
      "he": "באותו זמן",
      "start_word": 160,
      "end_word": 163
    },
    {
      "id": "gloss-49",
      "paragraph": 3,
      "en": "so listeners",
      "he": "ולכן המאזינים",
      "start_word": 164,
      "end_word": 165
    },
    {
      "id": "gloss-50",
      "paragraph": 3,
      "en": "could not understand",
      "he": "לא הצליחו להבין",
      "start_word": 166,
      "end_word": 168
    },
    {
      "id": "gloss-51",
      "paragraph": 3,
      "en": "the guest's answer.",
      "he": "את תשובת האורח",
      "start_word": 169,
      "end_word": 171
    },
    {
      "id": "gloss-52",
      "paragraph": 3,
      "en": "After that,",
      "he": "לאחר מכן",
      "start_word": 172,
      "end_word": 173
    },
    {
      "id": "gloss-53",
      "paragraph": 3,
      "en": "the team began practising interviews",
      "he": "הצוות התחיל לתרגל ראיונות",
      "start_word": 174,
      "end_word": 178
    },
    {
      "id": "gloss-54",
      "paragraph": 3,
      "en": "before recording them.",
      "he": "לפני הקלטתם",
      "start_word": 179,
      "end_word": 181
    },
    {
      "id": "gloss-55",
      "paragraph": 3,
      "en": "They also learnt",
      "he": "הם גם למדו",
      "start_word": 182,
      "end_word": 184
    },
    {
      "id": "gloss-56",
      "paragraph": 3,
      "en": "to ask short questions",
      "he": "לשאול שאלות קצרות",
      "start_word": 185,
      "end_word": 188
    },
    {
      "id": "gloss-57",
      "paragraph": 3,
      "en": "and wait for the answers.",
      "he": "ולהמתין לתשובות",
      "start_word": 189,
      "end_word": 193
    },
    {
      "id": "gloss-58",
      "paragraph": 3,
      "en": "Now a teacher checks",
      "he": "כעת מורה בודקת",
      "start_word": 194,
      "end_word": 197
    },
    {
      "id": "gloss-59",
      "paragraph": 3,
      "en": "each programme",
      "he": "כל תוכנית",
      "start_word": 198,
      "end_word": 199
    },
    {
      "id": "gloss-60",
      "paragraph": 3,
      "en": "before it is played.",
      "he": "לפני שהיא מושמעת",
      "start_word": 200,
      "end_word": 203
    },
    {
      "id": "gloss-61",
      "paragraph": 3,
      "en": "However,",
      "he": "עם זאת",
      "start_word": 204,
      "end_word": 204
    },
    {
      "id": "gloss-62",
      "paragraph": 3,
      "en": "the pupils still choose",
      "he": "התלמידים עדיין בוחרים",
      "start_word": 205,
      "end_word": 208
    },
    {
      "id": "gloss-63",
      "paragraph": 3,
      "en": "the topics themselves.",
      "he": "את הנושאים בעצמם",
      "start_word": 209,
      "end_word": 211
    },
    {
      "id": "gloss-64",
      "paragraph": 4,
      "en": "After three months,",
      "he": "אחרי שלושה חודשים",
      "start_word": 212,
      "end_word": 214
    },
    {
      "id": "gloss-65",
      "paragraph": 4,
      "en": "more pupils wanted",
      "he": "תלמידים נוספים רצו",
      "start_word": 215,
      "end_word": 217
    },
    {
      "id": "gloss-66",
      "paragraph": 4,
      "en": "to join the team.",
      "he": "להצטרף לצוות",
      "start_word": 218,
      "end_word": 221
    },
    {
      "id": "gloss-67",
      "paragraph": 4,
      "en": "One of them was Maya,",
      "he": "אחת מהם הייתה מאיה",
      "start_word": 222,
      "end_word": 226
    },
    {
      "id": "gloss-68",
      "paragraph": 4,
      "en": "who had been afraid",
      "he": "שחששה",
      "start_word": 227,
      "end_word": 230
    },
    {
      "id": "gloss-69",
      "paragraph": 4,
      "en": "to speak in front of her class.",
      "he": "לדבר בפני כיתתה",
      "start_word": 231,
      "end_word": 237
    },
    {
      "id": "gloss-70",
      "paragraph": 4,
      "en": "She started by writing the news",
      "he": "היא התחילה בכתיבת החדשות",
      "start_word": 238,
      "end_word": 243
    },
    {
      "id": "gloss-71",
      "paragraph": 4,
      "en": "and later agreed",
      "he": "ובהמשך הסכימה",
      "start_word": 244,
      "end_word": 246
    },
    {
      "id": "gloss-72",
      "paragraph": 4,
      "en": "to read it with a friend.",
      "he": "לקרוא אותן עם חבר או חברה",
      "start_word": 247,
      "end_word": 252
    },
    {
      "id": "gloss-73",
      "paragraph": 4,
      "en": "She still feels nervous",
      "he": "היא עדיין חשה חשש",
      "start_word": 253,
      "end_word": 256
    },
    {
      "id": "gloss-74",
      "paragraph": 4,
      "en": "before a programme,",
      "he": "לפני תוכנית",
      "start_word": 257,
      "end_word": 259
    },
    {
      "id": "gloss-75",
      "paragraph": 4,
      "en": "but she no longer avoids speaking.",
      "he": "אבל היא כבר לא נמנעת מלדבר",
      "start_word": 260,
      "end_word": 265
    },
    {
      "id": "gloss-76",
      "paragraph": 4,
      "en": "The team now hopes",
      "he": "הצוות מקווה כעת",
      "start_word": 266,
      "end_word": 269
    },
    {
      "id": "gloss-77",
      "paragraph": 4,
      "en": "to interview people",
      "he": "לראיין אנשים",
      "start_word": 270,
      "end_word": 272
    },
    {
      "id": "gloss-78",
      "paragraph": 4,
      "en": "from outside the school.",
      "he": "מחוץ לבית הספר",
      "start_word": 273,
      "end_word": 276
    },
    {
      "id": "gloss-79",
      "paragraph": 4,
      "en": "Before doing that,",
      "he": "לפני שיעשו זאת",
      "start_word": 277,
      "end_word": 279
    },
    {
      "id": "gloss-80",
      "paragraph": 4,
      "en": "the pupils need to learn",
      "he": "התלמידים צריכים ללמוד",
      "start_word": 280,
      "end_word": 284
    },
    {
      "id": "gloss-81",
      "paragraph": 4,
      "en": "how to arrange interviews",
      "he": "איך לתאם ראיונות",
      "start_word": 285,
      "end_word": 288
    },
    {
      "id": "gloss-82",
      "paragraph": 4,
      "en": "with busy guests.",
      "he": "עם אורחים עסוקים",
      "start_word": 289,
      "end_word": 291
    }
