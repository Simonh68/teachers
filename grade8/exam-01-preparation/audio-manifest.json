    "story-01": {
      "src": "audio/story-01-3f7b039cc4e6.mp3",
      "text": "I am at one of the most unusual festivals in the world – the Monkey Festival in Lopburi, Thailand.",
      "duration": 6.6,
      "sha256": "a420441fceb18faf790707960c411e0c4ff9cf4236c938016688d238d152ccfb"
    },
    "story-02": {
      "src": "audio/story-02-2ad25a30ec67.mp3",
      "text": "People are getting ready for the festival, so I finally have some time to write about my adventures.",
      "duration": 5.88,
      "sha256": "fbc85f5e2cae045a15594ea6cdc045147f1ad5bc68695cfeb9637bf646b62516"
    },
    "story-03": {
      "src": "audio/story-03-132354fee839.mp3",
      "text": "Everybody in town gets together and the entire town goes a little crazy on this day!",
      "duration": 5.52,
      "sha256": "88dc7cdf6ed262051af10edd9eef95da2014eebf5cfc44f68d37e40924c724a3"
    },
    "story-04": {
      "src": "audio/story-04-6773b6dc62aa.mp3",
      "text": "Many people are dressed like monkeys, and the festival has live performances and dances.",
      "duration": 5.76,
      "sha256": "bf56b1b1b01c17681e634a300b1f78970a94aeb0502f610c4348756662d90a65"
    },
    "story-05": {
      "src": "audio/story-05-b416ea70549f.mp3",
      "text": "The first thing you notice when you look around town are the monkeys.",
      "duration": 3.912,
      "sha256": "a2e87a30bc777f4f21295aeff087f9621245fb03d3b68102b8c03bca32479cca"
    },
    "story-06": {
      "src": "audio/story-06-8139d102ccb4.mp3",
      "text": "They are everywhere!",
      "duration": 1.272,
      "sha256": "d7fe3c5beb25007580cf3fc2ebff49183d524cd7d56cdb8b50d7611596943050"
    },
    "story-07": {
      "src": "audio/story-07-6b3f22df8554.mp3",
      "text": "I can see a few of them right now.",
      "duration": 2.064,
      "sha256": "02b8e430fffc51732cf31b65f97f88891a2e79c9b3cd230b71734a32357414b0"
    },
    "story-08": {
      "src": "audio/story-08-91438cc1b30a.mp3",
      "text": "They are gathered together on the street corner, playing with each other and making loud noises.",
      "duration": 5.544,
      "sha256": "51fa960994f2e30c28469cd5455f3a49eb13e0753aa0f4d82ccb64b3878d7463"
    },
    "story-09": {
      "src": "audio/story-09-7487e2643800.mp3",
      "text": "They may look cute, but you have to be careful.",
      "duration": 2.616,
      "sha256": "45e9d3417602dd69b406580bcbeee827647229d82469ef4cdac4f0719b05907c"
    },
    "story-10": {
      "src": "audio/story-10-d257cd08a0de.mp3",
      "text": "These monkeys can cause major trouble.",
      "duration": 2.352,
      "sha256": "7c40cc58ed55173e78ea7d1d688bc8ada943bc16fd1c29523bd0f4dfe7baa875"
    },
    "story-11": {
      "src": "audio/story-11-765838e36df4.mp3",
      "text": "They like to take things from people, especially food and drinks, and even valuable things, like handbags and sunglasses.",
      "duration": 7.848,
      "sha256": "b99b98ee614576485565dfd1c156d58fd9919a611cd0b01863df7c1d01f5c3ba"
    },
    "story-12": {
      "src": "audio/story-12-6f91be8d70d2.mp3",
      "text": "This is an annual festival, and people look forward to it all year.",
      "duration": 4.128,
      "sha256": "86e38b5bb2099c293f116cbe6aa359fb3922cf3674b129ec35702e7c3441ef49"
    },
    "story-13": {
      "src": "audio/story-13-bf97adacda58.mp3",
      "text": "Early in the morning, people prepare huge plates of fruit and put them on long tables.",
      "duration": 5.4,
      "sha256": "ecd827b2edf3679dba8b4aac267102276507ff57fd333934debdf88d7a8b7b05"
    },
    "story-14": {
      "src": "audio/story-14-73e977e1503c.mp3",
      "text": "The tables look beautiful, but they aren’t going to stay that way.",
      "duration": 3.648,
      "sha256": "554cab93681ad07435fded454c1bcb1a97e86a2a02e871b6cb6d7b12247e900d"
    },
    "story-15": {
      "src": "audio/story-15-c4ce1b53b296.mp3",
      "text": "The best part of the festival is when thousands of excited monkeys jump on the tables and eat as much fruit as they possibly can.",
      "duration": 8.664,
      "sha256": "7eedce31bea43abd135a7c3d5305c5a856e8fb2ed275f1177199b6bf0c60faf8"
    },
    "story-16": {
      "src": "audio/story-16-771116ff0540.mp3",
